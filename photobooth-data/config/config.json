  "share": {
    "sharing_enabled": true,
    "actions": [
      {
        "name": "Printing",
        "handles_images_only": true,
        "processing": {
          "share_command": "echo printing {filename} on {printer_name} media_type={media_type} action_config_name={action_config_name} copies={copies}",
